# Supabase connection for the STEM Camp Field Notebook.
#
# The anon (publishable) key is designed to be exposed in the browser; Row Level
# Security enforces access (see supabase/schema.sql). Set these as GitHub Actions
# secrets for deployments (Settings -> Secrets and variables -> Actions), or copy
# this file to .env.local for local development. Empty or unset values mean
# seed-only, so the public site still renders from bundled data while admin
# sign-in is disabled.
#
# Vite only exposes variables prefixed with VITE_ to the browser bundle.

VITE_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR-PUBLISHABLE-ANON-KEY
VITE_SUPABASE_TABLE=collections
